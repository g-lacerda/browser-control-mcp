{
  "manifest_version": 2,
  "name": "Claude no Navegador",
  "version": "1.7.0",
  "description": "Deixa o Claude (Claude Code) navegar, clicar e digitar nas abas do grupo Claude, com a conexão só local.",
  "permissions": [
    "tabs",
    "tabGroups",
    "history",
    "storage",
    "webRequest",
    "<all_urls>"
  ],
  "optional_permissions": [
    "find"
  ],
  "background": {
    "scripts": [
      "dist/background.js"
    ]
  },
  "browser_action": {
    "default_icon": "assets/icone.svg",
    "default_title": "Claude no Navegador",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-no-firefox@g-lacerda",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "browsingActivity"
        ]
      }
    }
  },
  "content_security_policy": "script-src 'self'; object-src 'self'; connect-src ws://localhost:* ws://127.0.0.1:* ws://[::1]:*",
  "icons": {
    "48": "assets/icone.svg",
    "96": "assets/icone.svg"
  }
}
